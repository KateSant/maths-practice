    },
    {
      "key": "alg-substitute-two-terms",
      "band": 4,
      "archetype": "A",
      "answerType": "SINGLE_CHOICE",
      "prompt": "Work out the value of 2a + 3b when a = 5 and b = −2.",
      "options": [
        {
          "text": "4",
          "correct": true
        },
        {
          "text": "10",
          "correct": false,
          "catches": "ALG-PARTIAL-SUBSTITUTION"
        },
        {
          "text": "16",
          "correct": false,
          "catches": "ALG-SUBSTITUTE-NEG"
        },
        {
          "text": "−4",
          "correct": false,
          "catches": "ALG-SUBSTITUTE-NEG"
        }
      ],
      "explanation": "2a = 2 × 5 = 10 and 3b = 3 × (−2) = −6, so 10 + (−6) = 4. Substituting only a gives 10 and ignores the second term. 16 treats b as +2, and −4 makes the 10 negative as well as the 6."
    },
    {
      "key": "alg-sometimes-2a-means-2-times-a",
      "band": 3,
      "archetype": "H",
      "answerType": "SINGLE_CHOICE",
      "prompt": "Does 2a always mean 2 × a?",
      "options": [
        {
          "text": "Always",
          "correct": true
        },
        {
          "text": "Sometimes",
          "correct": false,
          "catches": "ALG-LETTER-OBJECT"
        },
        {
          "text": "Never",
          "correct": false,
          "catches": "ALG-LETTER-OBJECT"
        }
      ],
      "explanation": "Always. Writing a number next to a letter means they are multiplied, so 2a is 2 × a whatever a is. The letter stands for a number, not an object, so 2a is never \"2 apples\" as a separate thing."
    }
  ]
}