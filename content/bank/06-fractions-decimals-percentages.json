    {
      "key": "fdp-percent-of-240",
      "band": 2,
      "archetype": "A",
      "answerType": "SINGLE_CHOICE",
      "prompt": "What is 25% of 240?",
      "options": [
        {
          "text": "60",
          "correct": true
        },
        {
          "text": "25",
          "correct": false,
          "catches": "FDP-PERCENT-WHOLE"
        },
        {
          "text": "96",
          "correct": false,
          "catches": "FDP-FRAC-PCT"
        },
        {
          "text": "40",
          "correct": false,
          "catches": "FDP-PERCENT-WHOLE"
        }
      ],
      "explanation": "25% is one quarter, and 240 ÷ 4 = 60. Writing 25 treats the percentage as the answer itself. 96 is 40% of 240, not 25%, and 40 comes from dividing by 6 instead of 4."
    },
    {
      "key": "fdp-increase-80-by-15",
      "band": 2,
      "archetype": "A",
      "answerType": "SINGLE_CHOICE",
      "prompt": "Increase 80 by 15%.",
      "options": [
        {
          "text": "92",
