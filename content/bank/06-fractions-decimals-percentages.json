        },
        {
          "text": "0.15",
          "correct": false,
          "catches": "FDP-INCREASE-MULT"
        },
        {
          "text": "15",
          "correct": false,
          "catches": "FDP-PERCENT-WHOLE"
        },
        {
          "text": "0.85",
          "correct": false,
          "catches": "FDP-DECREASE-MULT"
        }
      ],
      "explanation": "Increasing by 15% leaves the whole amount, 100%, plus another 15%, so the multiplier is 1.15. Multiplying by 0.15 finds only the increase, by 15 makes the amount far too large, and 0.85 decreases the amount by 15%."
    },
    {
      "key": "fdp-percentage-points",
      "band": 3,
      "archetype": "C",
      "answerType": "SINGLE_CHOICE",
      "prompt": "A pass rate rises from 20% to 25%. By how many percentage points does it rise?",
      "options": [
        {
          "text": "5",
          "correct": true
        },
        {
          "text": "25",
          "correct": false,
          "catches": "FDP-PCT-POINTS"
        },
        {
          "text": "20",
          "correct": false,
          "catches": "FDP-PCT-POINTS"
        },
        {
          "text": "125",
          "correct": false,
          "catches": "FDP-PCT-POINTS"
        }
      ],
      "explanation": "The rate itself has risen by 25 − 20 = 5 percentage points. Percentages and percentage points are different measures: 5 points is a rise of 5 out of 100, which as a proportion of the old rate is 25%."
