    {
      "key": "fdp-fraction-to-percent",
      "band": 1,
      "archetype": "G",
      "answerType": "SINGLE_CHOICE",
      "prompt": "Which percentage is equal to 2/5?",
      "options": [
        {
          "text": "40%",
          "correct": true
        },
        {
          "text": "25%",
          "correct": false,
          "catches": "FDP-FRAC-PCT"
        },
        {
          "text": "4%",
          "correct": false,
          "catches": "FDP-FRAC-100"
        },
        {
          "text": "250%",
          "correct": false,
          "catches": "FDP-FRAC-PCT"
        }
      ],
      "explanation": "2/5 = 4/10 = 40/100, so it is 40%. 25% is 1/4, not 2/5. 4% comes from taking the numerator alone, and 250% comes from dividing 5 by 2 the wrong way round."
    },
    {
      "key": "fdp-decimal-to-percent",
      "band": 2,
      "archetype": "C",
      "answerType": "SINGLE_CHOICE",
      "prompt": "Which percentage is equal to 0.4?",
      "options": [
        {
          "text": "40%",
          "correct": true
        },
        {
          "text": "4%",
          "correct": false,
          "catches": "FDP-FRAC-100"
        },
        {
          "text": "0.4%",
          "correct": false,
          "catches": "FDP-FRAC-100"
        },
        {
          "text": "400%",
          "correct": false,
          "catches": "FDP-PCT-TO-DEC"
        }
      ],
      "explanation": "A percentage is a fraction out of 100, so multiply the decimal by 100: 0.4 = 40%. Moving the point one place gives 4%, which is ten times too small; 0.4% is a hundred times too small; and 400% is ten times too big."
    },
